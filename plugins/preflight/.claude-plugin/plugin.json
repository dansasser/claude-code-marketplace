{
  "name": "preflight",
  "version": "1.0.0",
  "description": "Multi-agent CI/CD pipeline ensuring Python packages pass cross-platform, multi-version, and quality gates before shipping to GitHub or PyPI.",
  "author": {
    "name": "Daniel T Sasser II",
    "email": "contact@dansasser.me",
    "url": "https://github.com/dansasser"
  },
  "homepage": "https://github.com/dansasser/claude-code-marketplace/tree/main/plugins/preflight",
  "repository": "https://github.com/dansasser/claude-code-marketplace",
  "license": "MIT",
  "keywords": [
    "ci-cd",
    "python",
    "cross-platform",
    "testing",
    "packaging",
    "quality-gates",
    "pypi",
    "github",
    "security",
    "coverage"
  ],
  "category": "Development Tools",
  "agents": [
    {
      "name": "preflight-orchestrator",
      "description": "Coordinates all 8 quality gates"
    },
    {
      "name": "lint-test",
      "description": "Gate 1: Linting and testing"
    },
    {
      "name": "coverage",
      "description": "Gate 2: Test coverage enforcement"
    },
    {
      "name": "cross-platform",
      "description": "Gate 3: Windows + Ubuntu compatibility"
    },
    {
      "name": "python-matrix",
      "description": "Gate 4: Python 3.9-3.13 testing"
    },
    {
      "name": "security",
      "description": "Gate 5: Security audit"
    },
    {
      "name": "api-compat",
      "description": "Gate 6: API compatibility"
    },
    {
      "name": "packaging",
      "description": "Gate 7: Package build verification"
    },
    {
      "name": "github-pr",
      "description": "Gate 8: GitHub PR creation"
    },
    {
      "name": "planning",
      "description": "Advisory: Architecture analysis"
    },
    {
      "name": "deps",
      "description": "Advisory: Dependency health"
    }
  ],
  "skills": [
    "state-management",
    "lint-tools",
    "coverage-tools",
    "xplat-checks",
    "python-matrix",
    "security-scan",
    "api-analysis",
    "package-build",
    "github-integration"
  ],
  "commands": [
    {
      "name": "preflight",
      "description": "Run full 8-gate pipeline"
    },
    {
      "name": "gate",
      "description": "Run specific gate by number/name"
    },
    {
      "name": "status",
      "description": "Check pipeline status"
    },
    {
      "name": "ship",
      "description": "Run pipeline and create PR"
    },
    {
      "name": "lint",
      "description": "Quick lint check"
    },
    {
      "name": "xplat",
      "description": "Quick cross-platform check"
    },
    {
      "name": "security",
      "description": "Quick security scan"
    }
  ],
  "dependencies": {
    "python": ">=3.9",
    "packages": [
      "ruff>=0.1.0",
      "mypy>=1.0.0",
      "pytest>=7.0.0",
      "pytest-cov>=4.0.0",
      "build>=1.0.0",
      "twine>=4.0.0",
      "pip-audit>=2.0.0"
    ]
  }
}
